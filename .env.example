# Local defaults for a laptop host. Copy to .env (gitignored). Never commit real values.
# Production (synap.surf VPS) sets SURF_ENV=production and the block at the bottom.

# Moss keys for the LOCAL host AND for sealing into download packs (encrypted).
# Seal into apps/web/public/moss_vault.enc (never plaintext in the zip):
#   cd apps/web && npm run seal:moss
# The seal script reads this file. If keys are empty, Surf uses on-device keyword search.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# LiveKit is optional local voice (`livekit-server --dev` uses devkey/secret).
# Leave these unset unless you run LiveKit. Do not publish port 7880.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
DEFAULT_MODEL=llama3.2:1b
KEEP_ALIVE=24h

# OTP mail. Empty SMTP_HOST keeps codes in data/platform/mail-outbox.jsonl (mode 0600)
# so local harness can read them. Set SMTP on any host that real users sign in to.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Auth + thumbs SQLite (not the user's chat folder).
PLATFORM_DATA_DIR=
# development (default) or production. production hides /docs and warns if SMTP is missing.
SURF_ENV=development
LOG_LEVEL=info

# Browser origins allowed to call the host. Loopback regex is always allowed too.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:18766,http://localhost:18766,https://synap.surf,https://www.synap.surf

# Gunicorn needs host:port in one value (or HOST_BIND + HOST_PORT — both work).
# Keep this on 127.0.0.1. nginx is the public listener.
HOST_BIND=127.0.0.1:18765
HOST_PORT=18765

# Shared across gunicorn workers (platform SQLite). OTP issue is the tighter bucket.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=600
AUTH_IP_RATE_LIMIT=40
AUTH_IP_RATE_WINDOW_SECONDS=600
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=900
OTP_IP_RATE_LIMIT=20
OTP_IP_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=600
CHAT_RATE_PER_MINUTE=30
MAX_BODY_BYTES=2000000

# Admin console (/admin) — set only on the VPS, never commit real passwords.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# --- production VPS (do not commit the filled-in file) ---
# SURF_ENV=production
# PLATFORM_DATA_DIR=/var/lib/synap/platform
# CORS_ORIGINS=https://synap.surf,https://www.synap.surf
# SMTP_HOST=smtp.example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@synap.surf
# ADMIN_EMAILS=you@example.com
# ADMIN_PASSWORD=
