POSTGRES_USER=surf
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=surf
DATABASE_URL=postgresql://surf:change-me-long-random@postgres:5432/surf
VALKEY_URL=redis://valkey:6379/0
SEARXNG_URL=http://searxng:8080/search
SEARXNG_SECRET=change-me-openssl-rand-hex-32
# Access tokens are HS256 with this secret (aud stays "authenticated"). Do not commit a production secret.
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
JWT_AUDIENCE=authenticated
# console prints the OTP and returns dev_code. smtp uses SMTP_* (Resend free tier: smtp.resend.com).
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# file serves PACK_ROOT. s3 presigns R2 when the bucket and keys below are set.
PACK_BACKEND=file
PACK_ROOT=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Lite mode only. Postgres uses plans.features.max_devices (free plan default 3).
MAX_DEVICES=3
# Ed25519 seed, 32 bytes hex. Generate with: python services/api/scripts/licence_keypair.py
# Never commit a real seed. The desktop build verifies with the matching public key.
LICENCE_SIGNING_KEY_HEX=
LICENCE_KEY_ID=lic-2026-1
LICENCE_MAX_DEVICES=2
LICENCE_REFRESH_DAYS=30
LICENCE_GRACE_DAYS=7
# Required to call POST /v1/licences/revoke. Leave empty to refuse that route.
LICENCE_ADMIN_TOKEN=
# Activation attempts per window, per IP and per device hash. Failures count.
ACTIVATION_LIMIT=8
ACTIVATION_WINDOW=600
# Webhook secrets. Real values come from the provider dashboard. Empty refuses the route.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SEARCH_PER_MIN=10
SEARCH_PER_DAY=100
SEARCH_CACHE_TTL=600
# Empty in production. A comma-separated host list skips the private-IP block for local fixtures only.
FETCH_ALLOW_HOSTS=
MIN_APP_VERSION=0.1.0
