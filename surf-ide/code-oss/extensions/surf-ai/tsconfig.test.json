{
  // Compiles the vscode-independent unit tests (which the main build excludes)
  // to plain CommonJS so `node --test` can run them without an extra loader.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out", "out-test"]
}
