[Unit]
Description=Purge synap.surf platform ephemera (OTP/mail/unverified/feedback >24h)
After=network.target

[Service]
Type=oneshot
# Same user and env as synap-host.service so this purges /var/lib/synap/platform,
# not an empty checkout database.
User=prajugatmachrayt
Group=prajugatmachrayt
WorkingDirectory=/home/prajugatmachrayt/surf.ai/apps/host
EnvironmentFile=-/home/prajugatmachrayt/surf.ai/.env
Environment=PLATFORM_DATA_DIR=/var/lib/synap/platform
ExecStart=/home/prajugatmachrayt/surf.ai/apps/host/.venv/bin/python purge_platform.py
