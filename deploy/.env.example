# Environment for the docker-compose stack (deploy/docker-compose.yml reads this via
# `env_file: .env` — copy to deploy/.env and fill in). Every variable below is verified
# to be read by services/api code or the stack images. REQUIRED = must be set when
# SURF_ENV=production (★ = enforced at boot by app/startup_guard.py, which refuses to
# start otherwise). Placeholders only — never commit real values.

# ── mode ────────────────────────────────────────────────────────────────────
# development (default) or production. production enforces every REQUIRED below.
SURF_ENV=development

# ── required in production ─────────────────────────────────────────────────
# Postgres container bootstrap + healthcheck (consumed by the postgres image, not the API).
POSTGRES_USER=surf
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=surf
# API's Postgres DSN. Without it the API runs in LITE mode; non-LITE boot crashes if missing.
DATABASE_URL=postgresql://surf:change-me-long-random@postgres:5432/surf
# Valkey/Redis DSN. REQUIRED only when DATABASE_URL is set; used for the health ping.
VALKEY_URL=redis://valkey:6379/0
# HS256 signing secret for access tokens. REQUIRED: at least 32 chars, no placeholder text. ★
JWT_SECRET=
# OpenRouter master key for the Online gateway (POST /api/v1/chat). REQUIRED. ★
# A gateway-less deployment opts out with SURF_GATEWAY_OPTIONAL=1.
OPENROUTER_API_KEY=
# Console mode prints OTPs and returns dev_code. production requires smtp. ★
MAIL_MODE=smtp
# SMTP transport, used when MAIL_MODE=smtp. REQUIRED in production (guard checks MAIL_MODE itself).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── optional: auth + routing ───────────────────────────────────────────────
# Access-token audience claim. Default: authenticated.
JWT_AUDIENCE=authenticated
# Free-plan device cap. Used only in LITE mode; Postgres uses plans.features.max_devices.
MAX_DEVICES=3
# Minimum app version advertised to desktop clients for the update feed.
MIN_APP_VERSION=0.2.0
# Absolute base URL used in outbound links (e.g. email buttons). Falls back to the request URL.
PUBLIC_BASE_URL=
# Skip the OPENROUTER_API_KEY requirement on a gateway-less deployment.
SURF_GATEWAY_OPTIONAL=
# Force the in-memory LITE store even with a DATABASE_URL present. Development only.
SURF_API_LITE=

# ── optional: gateway ──────────────────────────────────────────────────────
# Upstream OpenRouter API base.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Final deduction = raw OpenRouter cost × this markup.
GATEWAY_MARKUP=1.20
# Signup credit in USD for a new gateway account. 0 means an admin top-up is needed first.
GATEWAY_STARTING_CREDIT=0
# Optional system prompt prepended to gateway chats.
GATEWAY_SYSTEM_PROMPT=
# Model price sync interval in seconds. 0 turns the sync off.
PRICING_SYNC_SECONDS=21600

# ── optional: HTTP entry rate limits (per user + per IP, 429 over limit) ────
# Chat requests per minute per user.
CHAT_RATE_PER_MINUTE=30
# Chat requests per minute per client IP (behind Caddy).
CHAT_IP_RATE_PER_MINUTE=60
# OTP requests per minute per email address.
OTP_RATE_PER_MINUTE=10
# OTP requests per minute per client IP.
OTP_IP_RATE_PER_MINUTE=20

# ── optional: licences ─────────────────────────────────────────────────────
# Ed25519 seed (32 bytes hex) that signs licence keys. Generate with
# python services/api/scripts/licence_keypair.py. Never commit a real seed.
LICENCE_SIGNING_KEY_HEX=
LICENCE_KEY_ID=lic-2026-1
# Device cap and lifetimes baked into issued licence keys.
LICENCE_MAX_DEVICES=2
LICENCE_REFRESH_DAYS=30
LICENCE_GRACE_DAYS=7
# Token protecting POST /v1/licences/revoke. Empty refuses the route.
LICENCE_ADMIN_TOKEN=
# Activation attempts allowed per window, per IP and per device hash. Failures count.
ACTIVATION_LIMIT=8
ACTIVATION_WINDOW=600
# Provider webhook secrets (verified by app/licences.py). Real values come from the
# provider dashboard; empty refuses that webhook. Item 19 adds charge-side keys.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── optional: pack distribution (API side) ─────────────────────────────────
# file serves packs from PACK_ROOT; s3 presigns an R2/S3 bucket.
PACK_BACKEND=file
PACK_ROOT=
# Object storage. R2_* takes precedence; S3_*/AWS_* are fallbacks (app/pack_catalog.py).
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Content key the API seals pack downloads with for a device (app/content_key.py).
PACK_CONTENT_KEY_HEX=

# ── pack builder (CI / pack box — not needed by the API container) ─────────
# Read by services/packs/build_pack.py and build_delta.py when building/sealing packs.
# Embeddings endpoint (a local llama-server) and its optional API key.
EMBED_URL=http://127.0.0.1:11434/v1/embeddings
EMBED_API_KEY=
# Ed25519 seed + key id that sign the pack/delta manifest.
PACK_SIGNING_KEY_HEX=
PACK_SIGNING_KEY_ID=
# Code-pack signing seed (64 hex chars), read by scripts/code-pack-src. A GitHub Actions secret.
CODE_PACK_SIGNING_KEY=
# Code-pack key id advertised in the manifest. Default: code-pack-dev.
CODE_PACK_SIGNING_KEY_ID=code-pack-dev
